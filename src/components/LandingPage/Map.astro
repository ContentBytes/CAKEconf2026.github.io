---
import SectionBackground from "../common/SectionBackground.astro";
---

<SectionBackground color="white">
  <div class="section__inner">
    <h2>Location</h2>
    <div class="container">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2561.2656530767986!2d19.921832112669627!3d50.06258637140188!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47165b0a14fa66bf%3A0xa5f244b37b6fec74!2sal.%20Adama%20Mickiewicza%209%2C%2033-332%20Krak%C3%B3w%2C%20Poland!5e0!3m2!1sen!2sde!4v1788702171989!5m2!1sen!2sde"
        width="500"
        height="450"
        loading="lazy"
        class="map"
      >
      </iframe>
      <div class="address">
        <p>Jagiellonian University</p>
        <p>Institute of English Studies</p>
        <p>al. Mickiewicza 9, Kraków</p>
      </div>
    </div>
  </div>
</SectionBackground>

<style>
  .container {
    display: flex;
    flex-direction: row;
    gap: 40px;
    padding: 50px 0;
  }

  .map {
    width: 60%;
  }

  .address {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .address p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .container {
      flex-direction: column-reverse;
    }

    .map {
      width: 100%;
    }
  }
</style>
