---
import Button from "../Button.astro"
import { allUrls } from "../../assets/allUrls.js";
---

<section class="section speakers background">
  <div class="section__inner">
    <h2>Speakers</h2>
    <p>By bringing together speakers from all kinds of professional backgrounds, we’re creating an agenda packed with fresh knowledge you won’t find anywhere else.</p>
    <a href="/speakers">
      <Button class="success-btn">View all speakers</Button>
    </a>
  </div>
</section>

<style>
  .speakers {
    background-color: #ECECEC;
    padding: 100px 0;
  }

  .section__inner p {
    padding: 40px 0;
  }
</style>
