---
/* Partners */
import TechwriterPL from "../../assets/partners/techwriter-pl.png";
import TWkoduje from "../../assets/partners/techwriter-koduje.png";
import Ways from "../../assets/partners/ways.png";
import Coffeece from "../../assets/partners/coffeece.png";
import UJ from "../../assets/partners/university.png";

/* Supported by */
import Google from "../../assets/partners/google.svg";

/* Sponsors */
import Hitachi from "../../assets/partners/hitachi.svg";
import Snagit from "../../assets/partners/snagit.svg";

const partners = [
  { name: "Jagiellonian University", image: UJ, url: "https://uj.edu.pl" },
  { name: "techwriter.pl", image: TechwriterPL, url: "https://techwriter.pl" },
  {
    name: "techwriter-koduje",
    image: TWkoduje,
    url: "https://techwriterkoduje.pl",
  },
  { name: "ways", image: Ways, url: "https://waysconf.com" },
  { name: "coffeece", image: Coffeece, url: "https://www.instagram.com/coffeece_krk" },
];
---

<section class="section background">
  <div class="section__inner">
    <h2>Partner with us</h2>
    <div class="description">
      <p>
        Want to get your brand more visible to the community? Contact us for
        sponsorship offers and partnership options.
      </p>
      <p>hello@contentbytes.pl</p>
    </div>
    <h3>Sponsored by:</h3>
    <div class="logos">
      <a href="https://www.hitachienergy.com/" target="_blank" rel="noopener noreferrer">
        <img src={Hitachi.src} alt="Hitachi Energy" title="Hitachi Energy" class="partner-image" />
      </a>
      <a href="https://www.techsmith.com/snagit" target="_blank" rel="noopener noreferrer">
        <img src={Snagit.src} alt="Camtasia Snagit" title="Camtasia Snagit" class="partner-image" />
      </a>
    </div>
    <h3>Supported by:</h3>
    <div class="logos">
      <img src={Google.src} alt="Google" title="Google" />
    </div>
    <h3>Media partners:</h3>
    <div class="logos">
      {
        partners.map((partner) => (
          <a href={partner.url} target="_blank" rel="noopener noreferrer">
          <img
            src={partner.image.src}
              alt={partner.name}
              class="partner-image"
              title=`Go to ${partner.url}`
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .background {
    background-color: #ececec;
    color: #000000;
    padding: 100px 0;
  }

  h3 {
    font-size: 32px;
    text-transform: uppercase;
  }

  .description {
    padding: 40px 0;
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    padding: 50px 0;
    gap: 50px;
  }

  .partner-image {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 50px;
    max-width: 200px;
    min-width: 200px;
    background-color: white;
  }
</style>
