---
import JakubImg from "../../assets/speakers/jakub-andrzejewski.png";
import MagdalenaImg from "../../assets/speakers/magdalena-pociecha.png";
import ScottImg from "../../assets/speakers/scott-deloach.png";
import ThomasImg from "../../assets/speakers/thomas-bro-rasmussen.png";
import KalinaImg from "../../assets/speakers/kalina-tyrkiel.png";
import JustinImg from "../../assets/speakers/justin-gagne.png";
import IanImg from "../../assets/speakers/ian-freeman.png";

const imgs: Record<string, ImageMetadata> = {
  jakub: JakubImg,
  magdalena: MagdalenaImg,
  scott: ScottImg,
  thomas: ThomasImg,
  kalina: KalinaImg,
  justin: JustinImg,
  ian: IanImg,
};

const speakers = [
  {
    id: "jakub",
    name: "Jakub Andrzejewski",
    title: "Full-Stack Developer, Educator",
  },
  {
    id: "magdalena",
    name: "Magdalena Pociecha",
    title: "UX Designer",
  },
  {
    id: "kalina",
    name: "Kalina Tyrkiel",
    title: "Senior Content Designer",
  },
  {
    id: "justin",
    name: "Justin Gagne",
    title: "Senior UX Writer, Educator",
  },
  {
    id: "ian",
    name: "Ian Freeman",
    title: "Senior Technical Writer",
  },
  {
    id: "scott",
    name: "Scott Deloach",
    title: "Content Experience Expert",
  },
  {
    id: "thomas",
    name: "Thomas Bro-Rasmussen",
    title: "Labeling Manager GN Hearing",
  },
];
---

<section class="section background">
  <div class="section__inner">
    <div class="speakers">
      {speakers.map((speaker) => (
        <div class="speaker">
          <img src={imgs[speaker.id].src} alt={speaker.name} class="picture" />
          <div class="speaker-details">
            <h3>{speaker.name}</h3>
            <p>{speaker.title}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .background {
    background-color: #ffffff;
    color: #000000;
    padding: 100px 0;
  }

  .speakers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 80px 80px;
  }

  .speaker {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Right column reversed */
  .speaker:nth-child(even) {
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  h3 {
    text-transform: uppercase;
    font-size: 32px;
  }

  .picture {
    max-height: 506px;
    max-width: 480px;
  }

  @media (max-width: 1080px) {
    .speakers {
      grid-template-columns: 1fr;
    }

    .speaker:nth-child(even) {
      flex-direction: column;
    }
  }
</style>