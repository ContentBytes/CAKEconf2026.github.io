---
import { Image } from "astro:assets";
import data from "../../data/cake2026.json";

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/speakers/*.png",
  { eager: true },
);

const imgs: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(files).map(([path, module]) => [
    path.split("/").pop()!.replace(".png", ""),
    module.default,
  ]),
);

const speakers = data.speakers.map((speaker) => ({
  id: speaker.id,
  name: speaker.name,
  title: speaker.title,
  image: imgs[speaker.id],
}));
---

<section class="section background">
  <div class="section__inner">
    <div class="speakers">
      {
        speakers.map((speaker) => (
          <div class="speaker">
            <img
              src={imgs[speaker.id].src}
              alt={speaker.name}
              class="picture"
            />
            <div class="speaker-details">
              <h3>{speaker.name}</h3>
              <p>{speaker.title}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .background {
    background-color: #ffffff;
    color: #000000;
    padding: 100px 0;
  }

  .speakers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 80px 80px;
  }

  .speaker {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Right column reversed */
  .speaker:nth-child(even) {
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  h3 {
    text-transform: uppercase;
    font-size: 32px;
  }

  .picture {
    max-height: 506px;
    max-width: 480px;
  }

  @media (max-width: 1080px) {
    .speakers {
      grid-template-columns: 1fr;
    }

    .speaker:nth-child(even) {
      flex-direction: column;
    }
  }
</style>
