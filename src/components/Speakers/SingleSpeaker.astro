---
import SectionBackground from "../common/SectionBackground.astro";
import InstagramIcon from "../../assets/icons/instagram.svg";
import LinkedinIcon from "../../assets/icons/linkedin.svg";

const {
  abstract,
  bio,
  name,
  image,
  showAgendaLink = true,
  linkedin,
  instagram,
} = Astro.props;
---

<SectionBackground color="grey">
  {abstract && <p class="abstract">{abstract}</p>}
  <div class="speaker-details">
    <img src={image.src} alt={name} class="speaker-image" />
    <div class="name-and-bio">
      <div class="name-and-icons">
        <p class="name">{name}</p>
        <div class="icons">
        {linkedin && (
          <a href={linkedin} target="_blank">
            <LinkedinIcon class="icon" />
          </a>
        )}
        {instagram && (
          <a href={instagram} target="_blank">
            <InstagramIcon class="icon" />
          </a>
        )}
        </div>
      </div>
      <p>{bio}</p>
    </div>
  </div>
  {
    showAgendaLink && (
      <div class="agenda-link">
        <a href="/agenda">Back to agenda</a>
      </div>
    )
  }
</SectionBackground>

<style>
  .abstract {
    padding-bottom: 100px;
  }

  .name {
    text-transform: uppercase;
    font-size: 48px;
    margin: 0;
  }

  .speaker-details {
    display: flex;
    flex-direction: row;
    gap: 30px;
  }

  .name-and-icons {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 24px;
  }

  .icon {
    width: 48px;
  }

  .icon:hover {
    color: var(--main-green);
  }

  .icons {
    display: flex;
    flex-direction: row;
    gap: 18px;
  }

  @media (max-width: 1080px) {
    .speaker-details {
      flex-direction: column;
    }
    .name-and-icons {
      flex-direction: column;
      align-items: start;
      padding-bottom: 12px;
  }}

  .speaker-image {
    max-width: 180px;
    height: 180px;
  }

  .agenda-link {
    text-align: center;
    margin-top: 50px;
    text-transform: uppercase;
    display: flex;
    justify-content: end;
  }

  .agenda-link:hover {
    color: var(--main-green);
  }

  .agenda-link a {
    text-decoration: none;
  }
</style>
