---
import SectionBackground from "../common/SectionBackground.astro";
import Session from "./Session.astro";
import Break from "./Break.astro";
import Talk from "./Talk.astro";

import { talk } from "../../utils/talk";
---

<SectionBackground color="white">
  <Break time="09:00" type="Registration opens" />
</SectionBackground>

<SectionBackground color="grey">
  <Session time="09:30-11:00">
    <Talk {...talk("lance-cummings")} />
    <Talk {...talk("marcel-rebro")} />
  </Session>
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session time="11:30-11:45">
      <Talk topic="Opening remarks" speaker="Content Bytes team" />
    </Session>
    <Session time="11:45-12:15">
      <Talk {...talk("kalina-tyrkiel-szymanska")} />
    </Session>
    <Session time="12:15-12:35">
      <Talk {...talk("marzena-cudecka")} />
    </Session>
    <Session time="12:35-13:05">
      <Talk {...talk("pawel-woznikowski")} />
    </Session>
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <div class="section">
    <Break time="13:05-14:00" type="Lunch break" />
  </div>
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session time="14:00-14:30">
      <Talk {...talk("jakub-andrzejewski", "magdalena-pociecha")} />
    </Session>
    <Session time="14:30-15:00">
      <Talk {...talk("mateusz-krol")} />
    </Session>
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <Break time="15:00-15:30" type="Coffee break" />
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session time="15:30-16:00">
      <Talk {...talk("ian-freeman")} />
    </Session>
    <Session time="16:00-16:30">
      <Talk {...talk("malgorzata-lis")} />
    </Session>
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <Break time="16:30-17:00" type="Coffee break" />
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session time="17:00-17:30">
      <Talk {...talk("monika-skoneczna", "gergely-garai")} />
    </Session>
    <Session time="17:30-17:40">
      <Talk topic="Closing remarks" speaker="Content Bytes team" />
    </Session>
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <Session time="19:00-?">
    <Talk topic="After party" speaker="More details soon!" />
  </Session>
</SectionBackground>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
</style>
