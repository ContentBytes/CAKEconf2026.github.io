---
import SectionBackground from "../common/SectionBackground.astro";
import Session from "./Session.astro";
import Break from "./Break.astro";

import { speakers } from "../../data/cake2026.json";
---

<SectionBackground color="white">
    <Break time="09:00" type="Registration opens" />
</SectionBackground>

<SectionBackground color="grey">
  <Session time="09:30-11:00" topic="Workshops" speaker="More details soon!" />
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session
      time="11:30-11:45"
      topic="Opening remarks"
      speaker="Content Bytes team"
    />
    <Session
      time="11:45-12:15"
      topic={speakers[2].topic}
      speaker={speakers[2].name}
      label={speakers[2].label}
      url={speakers[2].id}
    />
    <Session
      time="12:15-12:35"
      topic={speakers[4].topic}
      speaker={speakers[4].name}
      label={speakers[4].label}
      url={speakers[4].id}
    />
    <Session
      time="12:35-13:05"
      topic={speakers[5].topic}
      speaker={speakers[5].name}
      label={speakers[5].label}
      url={speakers[5].id}
    />
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <div class="section">
    <Break time="13:05-14:00" type="Lunch break" />
  </div>
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session
      time="14:00-14:30"
      topic={speakers[0].topic}
      speaker={`${speakers[0].name} and ${speakers[1].name}`}
      label={speakers[0].label}
      url={`${speakers[0].id}-and-${speakers[1].id}`}
    />
    <Session
      time="14:30-15:00"
      topic={speakers[6].topic}
      speaker={speakers[6].name}
      label={speakers[6].label}
      url={speakers[6].id}
    />
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <Break time="15:00-15:30" type="Coffee break" />
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session
      time="15:30-16:00"
      topic={speakers[7].topic}
      speaker={speakers[7].name}
      label={speakers[7].label}
      url={speakers[7].id}
    />
    <Session
      time="16:00-16:30"
      topic={speakers[10].topic}
      speaker={speakers[10].name}
      label={speakers[10].label}
      url={speakers[10].id}
    />
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <Break time="16:30-17:00" type="Coffee break" />
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session
      time="17:00-17:30"
      topic={speakers[11].topic}
      speaker={`${speakers[11].name} and ${speakers[12].name}`}
      label={speakers[11].label}
      url={`${speakers[11].id}-and-${speakers[12].id}`}
    />
    <Session time="17:30-17:40" topic="Closing remarks" speaker="Content Bytes team" />
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <Session time="19:00-?" topic="After party" speaker="More details soon!" />
</SectionBackground>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
</style>
