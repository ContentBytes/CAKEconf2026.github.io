---
import SectionBackground from "../common/SectionBackground.astro";
import Session from "./Session.astro";
import Break from "./Break.astro";
import Talk from "./Talk.astro";

import { talk } from "../../utils/talk";
---

<SectionBackground color="white">
  <Break time="09:00" type="Registration opens" />
</SectionBackground>

<SectionBackground color="grey">
  <Session time="09:30-11:00">
    <Talk {...talk("leo-breedt")} />
    <Talk {...talk("olga-stefaniuk-ziemecka")} />
  </Session>
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session time="11:25-11:30">
      <Talk topic="Opening remarks" speaker="Content Bytes team" />
    </Session>
    <Session time="11:30-12:00">
      <Talk {...talk("thomas-bro-rasmussen", "scott-deloach")} />
    </Session>
    <Session time="12:00-12:20">
      <Talk {...talk("aleksandra-kulga")} />
    </Session>
    <Session time="12:20-12:50">
      <Talk {...talk("anastasiya-biaroza")} />
    </Session>
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <div class="section">
    <Break time="12:50-14:00" type="Lunch break" />
  </div>
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session time="14:00-14:30">
      <Talk {...talk("justin-gagne")} />
    </Session>
    <Session time="14:30-15:00">
      <Talk {...talk("monika-mrozek")} />
    </Session>
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <Break time="15:00-15:30" type="Coffee break" />
</SectionBackground>

<SectionBackground color="white">
  <Session time="15:30-16:30">
    <Talk
      topic="Surprise slot"
      speaker="Be on the lookout for a great reveal really soon!"
    />
  </Session>
</SectionBackground>

<SectionBackground color="grey">
  <Break time="16:30-17:00" type="Coffee break" />
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session time="17:00-17:30">
      <Talk {...talk("tomas-nosek")} />
    </Session>
    <Session time="17:30-17:50">
      <Talk {...talk("agnieszka-marzec")} />
    </Session>
    <Session time="17:50-18:00">
      <Talk topic="Closing remarks" speaker="Content Bytes team" />
    </Session>
  </div>
</SectionBackground>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
</style>
