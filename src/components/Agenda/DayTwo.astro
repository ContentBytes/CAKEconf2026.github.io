---
import SectionBackground from "../common/SectionBackground.astro";
import Session from "./Session.astro";
import Break from "./Break.astro";

import { speakers } from "../../data/cake2026.json";
---

<SectionBackground color="white">
  <Break time="09:00" type="Registration opens" />
</SectionBackground>

<SectionBackground color="grey">
  <Session time="09:30-11:00" topic="Workshops" speaker="More details soon!" />
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session
    time="11:25-11:30"
    topic="Opening remarks"
    speaker="Content Bytes team"
  />
    <Session
      time="11:30-12:00"
      topic={speakers[8].topic}
      speaker={`${speakers[8].name} and ${speakers[9].name}`}
      label={speakers[8].label}
      url={`${speakers[8].id}-and-${speakers[9].id}`}
    />
    <Session
      time="12:00-12:20"
      topic={speakers[13].topic}
      speaker={speakers[13].name}
      label={speakers[13].label}
      url={speakers[13].id}
    />
    <Session
      time="12:20-12:50"
      topic={speakers[14].topic}
      speaker={speakers[14].name}
      label={speakers[14].label}
      url={speakers[14].id}
    />
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <div class="section">
    <Break time="12:50-14:00" type="Lunch break" />
  </div>
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session
      time="14:00-14:30"
      topic={speakers[3].topic}
      speaker={speakers[3].name}
      label={speakers[3].label}
      url={speakers[3].id}
    />
    <Session
      time="14:30-15:00"
      topic={speakers[15].topic}
      speaker={speakers[15].name}
      label={speakers[15].label}
      url={speakers[15].id}
    />
  </div>
</SectionBackground>

<SectionBackground color="grey">
  <Break time="15:00-15:30" type="Coffee break" />
</SectionBackground>

<SectionBackground color="white">
  <Session
    time="15:30-16:30"
    topic="Something new"
    speaker="More details soon!"
  />
</SectionBackground>

<SectionBackground color="grey">
  <Break time="16:30-17:00" type="Coffee break" />
</SectionBackground>

<SectionBackground color="white">
  <div class="section">
    <Session
      time="17:00-17:30"
      topic={speakers[16].topic}
      speaker={speakers[16].name}
      label={speakers[16].label}
      url={speakers[16].id}
    />
    <Session
      time="17:30-17:50"
      topic={speakers[17].topic}
      speaker={speakers[17].name}
      label={speakers[17].label}
      url={speakers[17].id}
    />
    <Session
    time="17:50-18:00"
    topic="Closing remarks"
    speaker="Content Bytes team"
  />
  </div>
</SectionBackground>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
</style>
