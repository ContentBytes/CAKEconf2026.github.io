---
const { time } = Astro.props;
---

<div class="session">
  <div class="time">{time}</div>
  <div class="talks"><slot /></div>
</div>

<style>
  .session {
    display: flex;
    flex-direction: row;
    gap: 40px;
  }

  @media (max-width: 768px) {
    .session {
      flex-direction: column;
    }
  }

  .talks {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .time {
    font-size: 48px;
    min-width: 270px;
  }
</style>
