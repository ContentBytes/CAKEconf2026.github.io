---
const { image, altText, phrases } = Astro.props;
---

<section class="section background">
  <img src={image.src} alt={altText} class="img"/>
  <div class="section__inner">
    <span class="phrases">
      {phrases.map((phrase: string) => (
        <p>{phrase}</p>
      ))}
    </span>
  </div>
</section>

<style>
  .background {
    background-color: #ffffff;
  }

  .img {
    width: 100%;
    height: auto;
    display: block;
  }

  .phrases {
    font-size: 32px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  @media only screen and (max-width: 768px) {
    .phrases {
      flex-direction: column;
    }
  }
</style>