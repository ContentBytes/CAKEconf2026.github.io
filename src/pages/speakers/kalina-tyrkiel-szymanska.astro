---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import data from "../../data/cake2026.json";
import SingleSpeaker from "../../components/Speakers/SingleSpeaker.astro";

const speaker = data.speakers.find(
  (speaker) => speaker.id === "kalina-tyrkiel-szymanska",
);
if (!speaker) throw new Error("Speaker not found");

import KalinaImg from "../../assets/speakers/kalina-tyrkiel-szymanska.png";
---

<Base
  title={speaker.topic}
  description={speaker.bio}
  canonicalPath={`/speakers/${speaker.id}`}
>
  <Hero title={speaker.topic} />
  <SingleSpeaker
    abstract={speaker.abstract}
    name={speaker.name}
    bio={speaker.bio}
    image={KalinaImg}
    linkedin={speaker.linkedin}
    instagram={speaker.instagram}
  />
</Base>
