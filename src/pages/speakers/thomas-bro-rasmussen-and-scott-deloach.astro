---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import data from "../../data/cake2026.json";
import SingleSpeaker from "../../components/Speakers/SingleSpeaker.astro";

const speakerOne = data.speakers.find(
  (speaker) => speaker.id === "thomas-bro-rasmussen",
);
if (!speakerOne) throw new Error("Speaker not found");

const speakerTwo = data.speakers.find(
  (speaker) => speaker.id === "scott-deloach",
);
if (!speakerTwo) throw new Error("Speaker not found");

import ThomasImg from "../../assets/speakers/thomas-bro-rasmussen.png";
import ScottImg from "../../assets/speakers/scott-deloach.png";
---

<Base
  title={speakerOne.topic}
  description={speakerOne.bio}
  canonicalPath={`/speakers/${speakerOne.id}-and-${speakerTwo.id}`}
>
  <Hero title={speakerOne.topic} />
  <SingleSpeaker
    abstract={speakerOne.abstract}
    name={speakerOne.name}
    bio={speakerOne.bio}
    image={ThomasImg}
    showAgendaLink={false}
  />
  <SingleSpeaker
    name={speakerTwo.name}
    bio={speakerTwo.bio}
    image={ScottImg}
  />
</Base>
